# ---------------------------------------------------------------
# Patra - environment variables. Copy to .env.local and fill in.
# ---------------------------------------------------------------

# Public URL of the site (used for SEO, sitemap, emails)
NEXT_PUBLIC_SITE_URL=https://patra.build-ai-version.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@build-ai-version.com
# Shown on Contact / policy pages (Razorpay website verification needs these)
NEXT_PUBLIC_BUSINESS_ADDRESS="Thakur Ventures, <full registered address>, <City>, <State> - <PIN>, India"
NEXT_PUBLIC_SUPPORT_PHONE="+91 XXXXX XXXXX"

# --- Free launch offer ---
# true = no payment: every PDF download is free (still emailed + backed up) and prices show "Free".
# Set to false (and rebuild) when you start charging.
NEXT_PUBLIC_FREE_LAUNCH=true

# --- Razorpay (Dashboard -> Account & Settings -> API Keys) ---
# Use rzp_test_... keys first, switch to rzp_live_... after activation.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: Dashboard -> Webhooks -> secret you set for https://<domain>/api/webhook
RAZORPAY_WEBHOOK_SECRET=

# --- AI auto-fill for the resume maker (paid; OFF by default) ---
# Set NEXT_PUBLIC_AI_AUTOFILL=true and add a key (console.anthropic.com -> API Keys) to turn it on.
NEXT_PUBLIC_AI_AUTOFILL=false
ANTHROPIC_API_KEY=

# --- Email (any SMTP provider) ---
# Gmail: smtp.gmail.com / 465 / your address / 16-char App Password
# Zoho:  smtp.zoho.in / 465     Amazon SES: email-smtp.ap-south-1.amazonaws.com / 465
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@yourdomain.com
SMTP_PASS=xxxxxxxxxxxxxxxx
MAIL_FROM="Patra <you@yourdomain.com>"
# Your copy of every sale (with transaction details) goes here
ADMIN_EMAIL=you@yourdomain.com

# --- Google Drive backup of every sold PDF (free; uses your Drive storage) ---
# Google Cloud Console -> enable "Google Drive API" -> OAuth client (type: Desktop app).
# Then run:  node scripts/google-drive-auth.mjs   and paste the refresh token below.
# Leave empty to disable backups.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional: top-level folder name in your Drive (created automatically)
GOOGLE_DRIVE_ROOT_FOLDER="Patra Orders"
