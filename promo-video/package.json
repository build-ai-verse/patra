{
  "name": "patra-promo-video",
  "private": true,
  "version": "1.0.0",
  "description": "Launch promo for Patra: Instagram Reel / YouTube Short (1080x1920) and YouTube (1920x1080), rendered with Remotion",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "npm run render:reel && npm run render:youtube && npm run still:cover && npm run still:thumb",
    "render:reel": "remotion render src/index.ts Reel out/patra-reel.mp4 --codec=h264 --crf=18",
    "render:youtube": "remotion render src/index.ts YouTube out/patra-youtube.mp4 --codec=h264 --crf=18",
    "still:cover": "remotion still src/index.ts Reel out/cover.png --frame=530",
    "still:thumb": "remotion still src/index.ts Thumbnail out/youtube-thumbnail.jpg --image-format=jpeg --jpeg-quality=90"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.545",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.545"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
